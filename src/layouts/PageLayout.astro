---
import MdxPageLayout from "astro-theme-university/layouts/MdxPageLayout.astro";
import { siteConfig } from "../site-config";
---

<MdxPageLayout siteConfig={siteConfig} {...Astro.props}>
  <slot />
</MdxPageLayout>

<style is:global>
  :root {
    color-scheme: dark;
    --at-primary: #69d9ff;
    --mastery-ink: #050811;
    --mastery-muted: #9caec1;
    --mastery-line: rgb(151 196 225 / 18%);
    --mastery-surface: rgb(14 23 38 / 88%);
    --mastery-surface-strong: #101b2d;
    --mastery-accent: #69d9ff;
    --mastery-gold: #d5ad58;
    --mastery-danger: #ff6b6b;
    --mastery-glow: 0 0 42px rgb(82 194 255 / 18%);
  }

  body {
    color: #eaf2f8;
    background-color: #050811;
    background-image:
      radial-gradient(circle at 88% 9%, rgb(37 139 205 / 16%), transparent 34rem),
      linear-gradient(90deg, rgb(105 217 255 / 3%) 1px, transparent 1px),
      linear-gradient(rgb(105 217 255 / 3%) 1px, transparent 1px);
    background-size: auto, 40px 40px, 40px 40px;
  }

  .at-nav { background: rgb(5 8 17 / 88%); border-bottom: 1px solid var(--mastery-line); backdrop-filter: blur(18px); }
  .at-nav-inner { padding-block: 1rem; }
  .at-nav-wordmark { color: white; font-weight: 900; letter-spacing: 0.05em; text-transform: uppercase; }
  .at-nav-links a { font-weight: 700; letter-spacing: 0.03em; }
  .at-main { padding-block-start: clamp(1rem, 3vw, 2.5rem); }
  .at-footer { background: #03050a; }
  .at-card { border-color: var(--mastery-line); background: linear-gradient(145deg, rgb(16 27 45 / 92%), rgb(7 12 22 / 96%)); box-shadow: 0 1.1rem 3rem rgb(0 0 0 / 22%); }
  .at-card-image { filter: saturate(0.9) contrast(1.08); }
  a.at-card:hover { border-color: rgb(105 217 255 / 55%); background: #101b2d; box-shadow: var(--mastery-glow); transform: translateY(-3px); }
  .at-card { transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease; }
  .at-card-title { color: #f4f8fb; }
  :where(h1, h2, h3) { color: #f6f9fb; font-family: "Arial Narrow", "Roboto Condensed", "Public Sans", sans-serif; font-weight: 900; letter-spacing: -0.035em; text-wrap: balance; }
  :where(p, li) { text-wrap: pretty; }
  a { text-underline-offset: 0.18em; }
  .eyebrow { margin: 0 0 0.7rem; color: var(--mastery-accent); font: 900 0.72rem/1.2 ui-monospace, monospace; letter-spacing: 0.16em; text-transform: uppercase; }
  .training-note { padding: 1rem 1.15rem; border: 1px solid rgb(213 173 88 / 28%); border-inline-start: 4px solid var(--mastery-gold); background: linear-gradient(90deg, rgb(213 173 88 / 10%), var(--mastery-surface)); }
  .training-note strong { color: var(--mastery-gold); }
  .riot-source { color: var(--mastery-muted); font-size: 0.72rem; }
  :focus-visible { outline: 3px solid var(--mastery-gold); outline-offset: 3px; }

  @media (prefers-reduced-motion: no-preference) {
    .at-card-image { transition: transform 420ms ease, filter 420ms ease; }
  }
</style>
