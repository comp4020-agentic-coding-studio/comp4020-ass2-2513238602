---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import { courseMeta } from "../course-config";
import { siteConfig } from "../site-config";

const loop = [
  ["01", "Plan", "Name the matchup, the window, and the one interaction you will test."],
  ["02", "Duel", "Run the same opening in a controlled 1v1 before ranked adds noise."],
  ["03", "Queue", "Take the plan into a full match and record the decision, not only the result."],
  ["04", "Review", "Separate what you knew then from what the replay reveals."],
  ["05", "Revise", "Change one variable, update the matchup card, and test it again."],
];
---

<ContentLayout title={`${courseMeta.code}: ${courseMeta.title}`} description={courseMeta.description} {...siteConfig}>
  <section class="hero-copy" aria-labelledby="course-promise">
    <div>
      <p class="eyebrow">One champion · every matchup · the whole map</p>
      <h2 id="course-promise">Choose one champion.<br />Make every counter explain itself.</h2>
      <p class="lede">
        Stop collecting tier lists. Build a champion you can trust: test every lane,
        trace every failure to a condition, then turn lane knowledge into objectives,
        side lanes, and teamfights.
      </p>
      <div class="actions">
        <a class="primary-action" href={withBase("/tools/matchup-atlas/")}>Open the Matchup Atlas</a>
        <a href={withBase("/sessions/")}>See the 12-week training route</a>
      </div>
    </div>
    <div class="map-board" aria-label="Abstract top-lane training diagram">
      <span class="map-label">TOP LANE // TEST 01</span>
      <span class="node node-a">YOU</span>
      <span class="node node-b">COUNTER</span>
      <span class="objective">ONE VARIABLE<br />PER RUN</span>
    </div>
  </section>

  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <section aria-labelledby="loop-title">
    <p class="eyebrow">The training contract</p>
    <h2 id="loop-title">No matchup claim without a replay</h2>
    <p>Champion mastery is a loop, not a build guide. Every week leaves behind a tested card in your personal playbook.</p>
    <ol class="loop-grid">
      {loop.map(([number, title, copy]) => (
        <li><span>{number}</span><h3>{title}</h3><p>{copy}</p></li>
      ))}
    </ol>
  </section>

  <section class="volibear-callout" aria-labelledby="volibear-title">
    <div><p class="eyebrow">Worked example · Volibear top</p><h2 id="volibear-title">A complete champion, not a favourable matchup</h2></div>
    <div><p>Follow one Volibear plan from practice tool to melee lane, ranged lane, hard counter, weak-side recovery, objective setup, and final teamfight role. The example gives you a method—not answers to copy.</p><a href={withBase("/tools/volibear-playbook/")}>Study the worked playbook →</a></div>
  </section>

  <h2>Build your mastery system</h2>
  <CardGrid columns={2}>
    <Card title="Lectures" href={withBase("/lectures/")}><p>Mechanics, matchup families, wave states, counters, and map conversion.</p></Card>
    <Card title="Champion Labs" href={withBase("/sessions/")}><p>Twelve evidence-led drills, each producing a playbook artefact.</p></Card>
    <Card title="Matchup Atlas" href={withBase("/tools/matchup-atlas/")}><p>Plan, test, and revisit every champion interaction.</p></Card>
    <Card title="Assessment" href={withBase("/assessments/")}><p>Protocol, counter portfolio, and final mastery playbook.</p></Card>
  </CardGrid>
</ContentLayout>

<style>
  .hero-copy { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 0.85fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; margin-block: 1rem 3rem; }
  .hero-copy h2 { margin: 0; font-size: clamp(2.5rem, 7vw, 5.8rem); line-height: 0.95; letter-spacing: -0.055em; }
  .lede { max-width: 62ch; margin-block: 1.5rem; color: var(--mastery-muted); font-size: clamp(1.05rem, 2vw, 1.3rem); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.9rem 1.2rem; align-items: center; }
  .primary-action { display: inline-flex; padding: 0.8rem 1rem; border: 2px solid var(--mastery-accent); color: white; background: var(--mastery-accent); font-weight: 800; text-decoration: none; }
  .map-board { position: relative; min-height: 25rem; overflow: hidden; border: 1px solid var(--mastery-line); background: linear-gradient(135deg, transparent 47%, color-mix(in srgb, var(--mastery-gold) 38%, transparent) 48% 52%, transparent 53%), radial-gradient(circle at 20% 80%, color-mix(in srgb, var(--mastery-accent) 22%, transparent), transparent 38%), var(--mastery-surface); }
  .map-board::before, .map-board::after { content: ""; position: absolute; width: 9rem; aspect-ratio: 1; border: 1px solid var(--mastery-line); border-radius: 50%; }
  .map-board::before { inset: -3rem auto auto -3rem; }
  .map-board::after { inset: auto -3rem -3rem auto; }
  .map-label { position: absolute; inset: 1rem auto auto 1rem; font: 700 0.72rem/1 monospace; letter-spacing: 0.1em; }
  .node { position: absolute; display: grid; width: 4.7rem; aspect-ratio: 1; place-items: center; border-radius: 50%; font: 800 0.7rem/1 monospace; }
  .node-a { inset: auto auto 18% 17%; color: white; background: var(--mastery-accent); }
  .node-b { inset: 20% 15% auto auto; color: white; background: var(--mastery-danger); }
  .objective { position: absolute; inset: 48% auto auto 48%; padding: 0.6rem; border: 1px solid var(--mastery-line); background: var(--at-bg, white); font: 800 0.68rem/1.3 monospace; transform: translate(-50%, -50%) rotate(-4deg); }
  .course-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-block: 0 4rem; padding: 0; list-style: none; }
  .course-tags li { padding: 0.3rem 0.65rem; border: 1px solid var(--mastery-line); border-radius: 999px; color: var(--mastery-muted); font-size: 0.85rem; }
  .loop-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; margin-block: 2rem 4rem; padding: 0; list-style: none; }
  .loop-grid li { min-width: 0; padding: 1.25rem; border-block: 1px solid var(--mastery-line); border-inline-start: 1px solid var(--mastery-line); }
  .loop-grid li:last-child { border-inline-end: 1px solid var(--mastery-line); }
  .loop-grid span { color: var(--mastery-gold); font: 800 0.8rem/1 monospace; }
  .loop-grid h3 { margin-block: 1.2rem 0.5rem; }
  .loop-grid p { margin: 0; color: var(--mastery-muted); font-size: 0.93rem; }
  .volibear-callout { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 2rem; align-items: end; margin-block: 4rem; padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid var(--mastery-line); background: linear-gradient(120deg, color-mix(in srgb, var(--mastery-gold) 18%, var(--at-bg, white)), var(--at-bg, white)); }
  .volibear-callout h2, .volibear-callout p { margin-block-end: 0; }
  @media (max-width: 800px) { .hero-copy, .volibear-callout { grid-template-columns: 1fr; } .map-board { min-height: 18rem; } .loop-grid { grid-template-columns: 1fr; } .loop-grid li { border-inline-end: 1px solid var(--mastery-line); border-block-end: 0; } .loop-grid li:last-child { border-block-end: 1px solid var(--mastery-line); } }
</style>
