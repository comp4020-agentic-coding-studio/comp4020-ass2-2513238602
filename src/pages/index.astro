---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { withBase } from "astro-theme-university/url";
import { courseMeta } from "../course-config";
import { dataDragonVersion } from "../data/champions";
import { portrait, splash } from "../lib/riot-assets";
import { siteConfig } from "../site-config";

const loop = [
  ["01", "PLAN", "Name one interaction and the exact condition you will test."],
  ["02", "DUEL", "Repeat the opening in a controlled 1v1 until the signal is clear."],
  ["03", "QUEUE", "Carry the rule into a full match with real map pressure."],
  ["04", "REVIEW", "Read the replay, isolate the decision, and challenge the claim."],
  ["05", "REVISE", "Change one variable, update the card, and run it again."],
];
const opponents = ["Jax", "Gwen", "Vayne", "Ornn"];
---

<BaseLayout title={`${courseMeta.code}: ${courseMeta.title}`} description={courseMeta.description} mainAttrs={{ class: "course-home" }} {...siteConfig}>
  <section class="hero" aria-labelledby="course-promise">
    <img class="hero-art" src={splash("Volibear").src} alt="Volibear standing in an ice storm, official League of Legends splash artwork" />
    <div class="hero-scrim"></div>
    <div class="hero-content">
      <p class="hero-code">SLOP3745 // SEASON 2027</p>
      <p class="eyebrow">One champion · every matchup · the whole map</p>
      <h1 id="course-promise">Master one.<br /><em>Answer everyone.</em></h1>
      <p class="lede">
        A twelve-week League of Legends training studio. Choose one champion,
        pressure-test every lane, and turn matchup knowledge into repeatable map decisions.
      </p>
      <div class="actions">
        <a class="primary-action" href={withBase("/tools/matchup-atlas/")}><span>Start training</span><b>→</b></a>
        <a class="text-action" href={withBase("/sessions/")}>Explore the 12-week route</a>
      </div>
    </div>
    <div class="hero-stats" aria-label="Course scale">
      <div><strong>173</strong><span>champions mapped</span></div>
      <div><strong>12</strong><span>weeks of practice</span></div>
      <div><strong>3×</strong><span>re-test standard</span></div>
    </div>
  </section>

  <section class="opponent-strip" aria-labelledby="opponent-title">
    <div class="opponent-copy">
      <p class="eyebrow">Your matchup is not a label</p>
      <h2 id="opponent-title">Every counter becomes a test.</h2>
    </div>
    <div class="opponent-faces">
      {opponents.map((id, index) => (
        <div class="face">
          <img src={portrait(id).src} alt={`${id} champion portrait`} loading="lazy" />
          <span>0{index + 1}</span><strong>{id}</strong>
        </div>
      ))}
      <a href={withBase("/tools/matchup-atlas/")}><strong>+169</strong><span>open full atlas</span></a>
    </div>
  </section>

  <section class="loop-section" aria-labelledby="loop-title">
    <div class="section-heading">
      <div><p class="eyebrow">The mastery loop</p><h2 id="loop-title">Play. Prove. Improve.</h2></div>
      <p>No claim earns a place in your playbook without a controlled test, a match clip, and a scheduled re-test.</p>
    </div>
    <ol class="loop-grid">
      {loop.map(([number, title, copy], index) => (
        <li style={`--step:${index}`}><span>{number}</span><h3>{title}</h3><p>{copy}</p><i aria-hidden="true">↗</i></li>
      ))}
    </ol>
  </section>

  <section class="volibear-feature" aria-labelledby="volibear-title">
    <img src={splash("Volibear").src} alt="Volibear official splash artwork" loading="lazy" />
    <div class="feature-copy">
      <p class="eyebrow">Worked champion · Volibear top</p>
      <h2 id="volibear-title">From first trade<br />to final objective.</h2>
      <p>Follow one complete model through melee, range, hard counter, weak side, side lane, objective setup and teamfight role. Then rebuild the method around your own champion.</p>
      <a href={withBase("/tools/volibear-playbook/")}>Enter the Volibear playbook <span>→</span></a>
    </div>
  </section>

  <section class="pathway" aria-labelledby="pathway-title">
    <div class="section-heading"><div><p class="eyebrow">Course system</p><h2 id="pathway-title">Four surfaces. One evidence trail.</h2></div></div>
    <CardGrid columns={2}>
      <Card title="01 / Lectures" href={withBase("/lectures/")} image={splash("Ryze")} imageAlt="Ryze official splash artwork"><p>Decision models for mechanics, waves, counters, review and map conversion.</p></Card>
      <Card title="02 / Champion Labs" href={withBase("/sessions/")} image={splash("Jax")} imageAlt="Jax official splash artwork"><p>Twelve pressure-tested drills that each leave behind a usable playbook artefact.</p></Card>
      <Card title="03 / Matchup Atlas" href={withBase("/tools/matchup-atlas/")} image={splash("Fiora")} imageAlt="Fiora official splash artwork"><p>Track all 173 champion interactions from unseen to mastered.</p></Card>
      <Card title="04 / Assessment" href={withBase("/assessments/")} image={splash("Ornn")} imageAlt="Ornn official splash artwork"><p>Three connected submissions: protocol, counter portfolio, and mastery capstone.</p></Card>
    </CardGrid>
  </section>

  <p class="riot-source">League of Legends champion artwork and portraits are cached locally from Riot Games Data Dragon {dataDragonVersion} for educational identification and resilient loading. This course is not endorsed by Riot Games.</p>
</BaseLayout>

<style>
  .hero { position: relative; min-height: min(47rem, 78vh); margin: 0 0 1.25rem; overflow: hidden; border: 1px solid var(--mastery-line); background: #07101d; box-shadow: 0 2.5rem 7rem rgb(0 0 0 / 42%); isolation: isolate; }
  .hero-art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 64% center; filter: saturate(0.78) contrast(1.16) brightness(0.78); z-index: -3; }
  .hero-scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(3 7 14 / 96%) 0 34%, rgb(3 7 14 / 72%) 52%, rgb(3 7 14 / 12%) 78%), linear-gradient(0deg, rgb(3 7 14 / 92%), transparent 45%); z-index: -2; }
  .hero::before { content: ""; position: absolute; inset: 0; background: linear-gradient(105deg, transparent 47%, rgb(105 217 255 / 18%) 47.15%, transparent 47.4%); z-index: -1; }
  .hero-content { display: grid; align-content: center; width: min(58%, 46rem); min-height: min(47rem, 78vh); padding: clamp(2rem, 6vw, 5rem); }
  .hero-code { position: absolute; inset: 1.4rem 1.4rem auto auto; margin: 0; color: rgb(255 255 255 / 58%); font: 800 0.7rem ui-monospace, monospace; letter-spacing: 0.14em; }
  :global(.course-home) { grid-column: full; padding-block-start: 0; }
  :global(.course-home > *) { grid-column: content; }
  :global(.course-home > .hero) { grid-column: full; width: min(100%, 1600px); margin-inline: auto; }
  .hero h1 { max-width: 9ch; margin: 0; color: #f6f9fb; font-family: "Arial Narrow", "Roboto Condensed", "Public Sans", sans-serif; font-size: clamp(4rem, 9vw, 8.8rem); font-weight: 900; line-height: 0.78; letter-spacing: -0.075em; text-transform: uppercase; text-shadow: 0 0 40px rgb(0 0 0 / 70%); }
  .hero h1 em { color: var(--mastery-gold); font-style: normal; }
  .lede { max-width: 50ch; margin-block: 1.7rem; color: #c1cfda; font-size: clamp(1rem, 1.8vw, 1.25rem); }
  .actions { display: flex; flex-wrap: wrap; gap: 1rem 1.4rem; align-items: center; }
  .primary-action { display: inline-flex; gap: 2.5rem; align-items: center; justify-content: space-between; min-width: 13rem; padding: 0.95rem 1.1rem; color: #04101a; background: var(--mastery-accent); font-weight: 900; text-decoration: none; text-transform: uppercase; letter-spacing: 0.04em; box-shadow: 0 0 35px rgb(105 217 255 / 25%); }
  .primary-action b { font-size: 1.35rem; }
  .text-action { color: white; font-weight: 800; }
  .hero-stats { position: absolute; inset: auto 0 0 auto; display: grid; grid-template-columns: repeat(3, minmax(8rem, 1fr)); width: min(48rem, 56%); border-top: 1px solid rgb(255 255 255 / 18%); border-left: 1px solid rgb(255 255 255 / 18%); background: rgb(4 8 16 / 72%); backdrop-filter: blur(15px); }
  .hero-stats div { display: grid; gap: 0.15rem; padding: 1.05rem 1.2rem; border-right: 1px solid rgb(255 255 255 / 12%); }
  .hero-stats strong { color: white; font-size: 1.75rem; line-height: 1; }
  .hero-stats span { color: #91a3b3; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .opponent-strip { display: grid; grid-template-columns: 0.85fr 1.6fr; gap: 2rem; align-items: center; padding: 2.2rem 0 4.5rem; }
  .opponent-copy h2 { margin: 0; font-size: clamp(2rem, 4vw, 4rem); line-height: 0.95; }
  .opponent-faces { display: grid; grid-template-columns: repeat(4, 1fr) 0.9fr; gap: 0.55rem; }
  .face, .opponent-faces > a { position: relative; min-height: 9rem; overflow: hidden; border: 1px solid var(--mastery-line); background: var(--mastery-surface); }
  .face img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.78) brightness(0.72); transition: transform 240ms ease, filter 240ms ease; }
  .face:hover img { transform: scale(1.07); filter: saturate(1) brightness(0.9); }
  .face span, .face strong { position: absolute; left: 0.65rem; z-index: 1; text-shadow: 0 2px 10px black; }
  .face span { top: 0.55rem; color: var(--mastery-gold); font: 900 0.65rem ui-monospace, monospace; }
  .face strong { bottom: 0.55rem; color: white; font-size: 0.75rem; text-transform: uppercase; }
  .opponent-faces > a { display: grid; align-content: center; padding: 1rem; color: white; text-decoration: none; }
  .opponent-faces > a strong { color: var(--mastery-accent); font-size: 1.7rem; }
  .opponent-faces > a span { color: var(--mastery-muted); font-size: 0.72rem; text-transform: uppercase; }
  .loop-section, .pathway { margin-block: 4rem 6rem; }
  .section-heading { display: flex; gap: 2rem; align-items: end; justify-content: space-between; margin-bottom: 1.8rem; }
  .section-heading h2 { margin: 0; font-size: clamp(3rem, 7vw, 6.5rem); line-height: 0.84; text-transform: uppercase; }
  .section-heading > p { max-width: 35rem; color: var(--mastery-muted); }
  .loop-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; margin: 0; padding: 0; list-style: none; }
  .loop-grid li { position: relative; min-height: 15rem; padding: 1.2rem; overflow: hidden; border: 1px solid var(--mastery-line); border-inline-end: 0; background: linear-gradient(160deg, rgb(20 35 56 / 88%), rgb(7 12 22 / 92%)); }
  .loop-grid li:last-child { border-inline-end: 1px solid var(--mastery-line); }
  .loop-grid li::before { content: ""; position: absolute; inset: 0; background: linear-gradient(145deg, transparent 62%, rgb(105 217 255 / 9%)); }
  .loop-grid span { color: var(--mastery-gold); font: 900 0.75rem ui-monospace, monospace; }
  .loop-grid h3 { margin: 3rem 0 0.7rem; font-size: 1.45rem; }
  .loop-grid p { margin: 0; color: var(--mastery-muted); font-size: 0.87rem; }
  .loop-grid i { position: absolute; inset: 0.8rem 0.8rem auto auto; color: rgb(255 255 255 / 18%); font-size: 2rem; font-style: normal; }
  .volibear-feature { position: relative; display: grid; grid-template-columns: 1.2fr 0.8fr; min-height: 35rem; margin-block: 5rem; overflow: hidden; border: 1px solid var(--mastery-line); background: #080d16; }
  .volibear-feature > img { position: absolute; inset: 0; width: 67%; height: 100%; object-fit: cover; object-position: 60% center; filter: saturate(0.65) contrast(1.12); }
  .volibear-feature::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, transparent 18%, rgb(8 13 22 / 35%) 49%, #080d16 69%); }
  .feature-copy { grid-column: 2; align-self: center; padding: clamp(2rem, 5vw, 4.5rem); z-index: 1; }
  .feature-copy h2 { margin: 0; font-size: clamp(2.6rem, 5vw, 5rem); line-height: 0.88; text-transform: uppercase; }
  .feature-copy p:not(.eyebrow) { color: var(--mastery-muted); }
  .feature-copy a { display: inline-flex; gap: 1rem; margin-top: 0.8rem; color: var(--mastery-accent); font-weight: 900; text-transform: uppercase; }
  .pathway :global(.at-card-title) { font-size: 1.45rem; text-transform: uppercase; }
  .pathway :global(.at-card-image) { aspect-ratio: 2 / 1; }
  @media (max-width: 850px) {
    .hero { min-height: 43rem; }
    .hero-content { width: 100%; min-height: 43rem; padding-bottom: 9rem; }
    .hero-scrim { background: linear-gradient(90deg, rgb(3 7 14 / 94%), rgb(3 7 14 / 38%)), linear-gradient(0deg, rgb(3 7 14 / 98%) 0 28%, transparent 65%); }
    .hero-stats { width: 100%; }
    .opponent-strip, .volibear-feature { grid-template-columns: 1fr; }
    .opponent-faces { grid-template-columns: repeat(5, minmax(5rem, 1fr)); overflow-x: auto; }
    .face, .opponent-faces > a { min-height: 7rem; }
    .loop-grid { grid-template-columns: 1fr; }
    .loop-grid li { min-height: 10rem; border-inline-end: 1px solid var(--mastery-line); border-block-end: 0; }
    .loop-grid li:last-child { border-block-end: 1px solid var(--mastery-line); }
    .loop-grid h3 { margin-top: 1.8rem; }
    .volibear-feature > img { width: 100%; opacity: 0.38; }
    .volibear-feature::after { background: linear-gradient(0deg, #080d16 5%, rgb(8 13 22 / 45%)); }
    .feature-copy { grid-column: 1; }
  }
  @media (max-width: 560px) {
    .hero-content { width: auto; max-width: 100%; padding: 2rem 1.35rem 9rem; overflow: hidden; }
    .hero .eyebrow { max-width: 100%; font-size: 0.62rem; letter-spacing: 0.1em; white-space: normal; }
    .hero h1 { max-width: 100%; font-size: clamp(3.2rem, 15vw, 4.45rem); line-height: 0.82; }
    .lede { max-width: 100%; font-size: 0.98rem; }
    .primary-action { width: 100%; min-width: 0; }
    .hero-code { display: none; }
    .hero-stats { grid-template-columns: repeat(3, 1fr); }
    .hero-stats div { padding: 0.8rem; }
    .hero-stats strong { font-size: 1.25rem; }
    .section-heading { display: block; }
    .opponent-strip { padding-top: 1rem; }
  }
</style>
