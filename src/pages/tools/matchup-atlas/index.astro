---
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { withBase } from "astro-theme-university/url";
import { champions, dataDragonVersion } from "../../../data/champions";
import { portrait, splash } from "../../../lib/riot-assets";
import { siteConfig } from "../../../site-config";

const laneCount = champions.filter((champion) => champion.lanePool).length;
const priorityChampions = champions.filter((champion) => champion.priority);
const typeOptions = ["All", "Fighter", "Tank", "Mage", "Assassin", "Marksman", "Support"];
---

<BaseLayout
  title="Volibear Matchup Atlas"
  description="A complete roster tracker for direct lane tests, global interactions, evidence, revisions, and scheduled re-tests."
  {...siteConfig}
>
  <header class="atlas-hero">
    <img class="atlas-hero-art" src={splash("Volibear").src} alt="Volibear official splash artwork" />
    <div class="atlas-hero-scrim"></div>
    <div>
      <p class="eyebrow">Selected mastery project · Top lane</p>
      <h1>All 173 opponents.<br />One evidence trail.</h1>
      <p class="atlas-lede">
        Learn the whole roster at the right resolution: direct tests for the course lane pool,
        recognition and teamfight plans for everyone else, then three-cycle re-tests for the ten
        interactions your own evidence ranks hardest.
      </p>
      <a class="playbook-link" href={withBase("/tools/volibear-playbook/")}>Read the worked Volibear playbook →</a>
    </div>
    <p class="atlas-stamp" aria-hidden="true"><strong>173</strong><span>COMPLETE ROSTER</span></p>
  </header>

  <section class="coverage" aria-labelledby="coverage-heading">
    <div>
      <p class="metric"><strong>{champions.length}</strong><span>roster entries</span></p>
      <p>Every champion receives a global interaction plan.</p>
    </div>
    <div>
      <p class="metric"><strong>{laneCount}</strong><span>lane-pool entries</span></p>
      <p>Course pool for direct one-versus-one testing; revise as the lane population changes.</p>
    </div>
    <div>
      <p class="metric"><strong>10 × 3</strong><span>pressure tests</span></p>
      <p>Ten evidence-ranked difficulties, each re-tested across three changed conditions.</p>
    </div>
    <h2 id="coverage-heading" class="sr-only">Coverage model</h2>
  </section>

  <aside class="training-note">
    <strong>Counter is a hypothesis.</strong> “Champion X counters Volibear” is too broad.
    Record the interaction, its conditions, the response you tested, and what would make you re-test it.
  </aside>

  <section class="priority" aria-labelledby="priority-heading">
    <div>
      <p class="eyebrow">Provisional queue · not a tier list</p>
      <h2 id="priority-heading">Volibear pressure-test ten</h2>
      <p>Begin here, then replace the order with your own replay and lab evidence.</p>
    </div>
    <ol>
      {priorityChampions.map((champion) => <li><button type="button" data-jump={champion.id}><img src={portrait(champion.id).src} alt="" loading="lazy" />{champion.name}</button></li>)}
    </ol>
  </section>

  <section class="dashboard" aria-labelledby="dashboard-heading">
    <div class="dashboard-head">
      <div>
        <p class="eyebrow">Persistent in this browser</p>
        <h2 id="dashboard-heading">Training dashboard</h2>
      </div>
      <div class="dashboard-actions">
        <button type="button" class="quiet" id="toggle-density" aria-pressed="false">Compact view</button>
        <button type="button" class="secondary" id="export-atlas">Export evidence JSON</button>
        <button type="button" class="quiet" id="reset-atlas">Reset statuses</button>
      </div>
    </div>

    <div class="atlas-controls">
    <div class="progress-panel">
      <div class="progress-copy">
        <strong id="progress-label">0 of {champions.length} started</strong>
        <span id="mastery-label">0 mastered</span>
      </div>
      <div class="progress-track" aria-hidden="true"><span id="progress-bar"></span></div>
      <ul class="status-legend" aria-label="Evidence stages">
        <li data-stage="unseen">Unseen</li><li data-stage="planned">Planned</li><li data-stage="1v1-tested">1v1</li><li data-stage="match-tested">Match</li><li data-stage="re-tested">Re-test</li><li data-stage="mastered">Mastered</li>
      </ul>
    </div>

    <div class="filters" role="search" aria-label="Filter matchup atlas">
      <label>
        <span>Search champion</span>
        <input id="atlas-search" type="search" placeholder="e.g. Jax or Mage" autocomplete="off" />
      </label>
      <label>
        <span>Coverage</span>
        <select id="scope-filter">
          <option value="all">Full roster</option>
          <option value="lane">Direct lane pool</option>
          <option value="global">Global interactions</option>
          <option value="priority">Pressure-test ten</option>
        </select>
      </label>
      <label>
        <span>Champion class</span>
        <select id="type-filter">
          {typeOptions.map((type) => <option value={type.toLowerCase()}>{type}</option>)}
        </select>
      </label>
      <label>
        <span>Evidence status</span>
        <select id="status-filter">
          <option value="all">All statuses</option>
          <option value="unseen">Unseen</option>
          <option value="planned">Planned</option>
          <option value="1v1-tested">1v1 tested</option>
          <option value="match-tested">Match tested</option>
          <option value="re-tested">Re-tested</option>
          <option value="mastered">Mastered</option>
        </select>
      </label>
    </div>

    <p id="filter-count" class="filter-count" aria-live="polite">Showing {champions.length} champions</p>
    </div>

    <div class="atlas-grid" id="atlas-grid">
      {champions.map((champion) => (
        <article
          class:list={["matchup-card", { priority: champion.priority, mirror: champion.id === "Volibear" }]}
          id={`champion-${champion.id}`}
          data-champion={champion.id}
          data-name={champion.name.toLowerCase()}
          data-tags={champion.tags.join(" ").toLowerCase()}
          data-lane={String(champion.lanePool)}
          data-priority={String(champion.priority)}
          data-status="unseen"
        >
          <div class="portrait-frame"><img src={portrait(champion.id).src} alt={`${champion.name} champion portrait`} loading="lazy" decoding="async" /></div>
          <div class="card-top">
            <div>
              <h3>{champion.name}</h3>
              <p>{champion.tags.join(" · ")}</p>
            </div>
            {champion.priority && <span class="priority-flag">Priority</span>}
          </div>
          <p class="focus"><strong>Test focus:</strong> {champion.focus}.</p>
          <p class="scope-label">{champion.lanePool ? "Direct lane test + global plan" : "Global interaction plan"}</p>
          <details>
            <summary>Open evidence prompts</summary>
            <ul>
              <li>What must {champion.name} spend before Volibear can commit?</li>
              <li>Which wave, terrain, or team condition changes the answer?</li>
              <li>What clip or controlled reset supports the current rule?</li>
              <li>What patch or failed repetition will trigger a re-test?</li>
            </ul>
          </details>
          <button type="button" class="status-button" data-status-button={champion.id}>
            <span>Status</span><strong>Unseen</strong>
          </button>
        </article>
      ))}
    </div>

    <p class="source-note">
      Roster names, role tags, and champion portraits are cached locally from Riot Games Data Dragon {dataDragonVersion} for educational identification and resilient loading.
      The lane pool and test priorities are course planning prompts, not live balance claims.
    </p>
  </section>
</BaseLayout>

<script is:inline define:vars={{ champions }}>
  const storageKey = "slop3745-matchup-atlas-v2";
  const stages = [
    { key: "unseen", label: "Unseen" },
    { key: "planned", label: "Planned" },
    { key: "1v1-tested", label: "1v1 tested" },
    { key: "match-tested", label: "Match tested" },
    { key: "re-tested", label: "Re-tested" },
    { key: "mastered", label: "Mastered" },
  ];

  const cards = Array.from(document.querySelectorAll("[data-champion]"));
  const search = document.querySelector("#atlas-search");
  const scopeFilter = document.querySelector("#scope-filter");
  const typeFilter = document.querySelector("#type-filter");
  const statusFilter = document.querySelector("#status-filter");
  const densityButton = document.querySelector("#toggle-density");
  const atlasGrid = document.querySelector("#atlas-grid");
  const countLabel = document.querySelector("#filter-count");
  const progressLabel = document.querySelector("#progress-label");
  const masteryLabel = document.querySelector("#mastery-label");
  const progressBar = document.querySelector("#progress-bar");

  let state = {};
  try { state = JSON.parse(localStorage.getItem(storageKey) || "{}"); } catch { state = {}; }

  function persist() {
    try { localStorage.setItem(storageKey, JSON.stringify(state)); } catch { /* status still works for this visit */ }
  }

  const stageFor = (id) => stages.find((stage) => stage.key === state[id]) || stages[0];

  function paintCard(card) {
    const id = card.dataset.champion;
    const stage = stageFor(id);
    card.dataset.status = stage.key;
    const label = card.querySelector("[data-status-button] strong");
    if (label) label.textContent = stage.label;
  }

  function updateProgress() {
    const values = champions.map((champion) => stageFor(champion.id).key);
    const started = values.filter((value) => value !== "unseen").length;
    const mastered = values.filter((value) => value === "mastered").length;
    progressLabel.textContent = `${started} of ${champions.length} started`;
    masteryLabel.textContent = `${mastered} mastered`;
    progressBar.style.width = `${(started / champions.length) * 100}%`;
  }

  function applyFilters() {
    const query = search.value.trim().toLowerCase();
    const scope = scopeFilter.value;
    const type = typeFilter.value;
    const status = statusFilter.value;
    let visible = 0;

    cards.forEach((card) => {
      const textMatch = !query || `${card.dataset.name} ${card.dataset.tags}`.includes(query);
      const scopeMatch = scope === "all"
        || (scope === "lane" && card.dataset.lane === "true")
        || (scope === "global" && card.dataset.lane === "false")
        || (scope === "priority" && card.dataset.priority === "true");
      const typeMatch = type === "all" || card.dataset.tags.split(" ").includes(type);
      const statusMatch = status === "all" || card.dataset.status === status;
      const show = textMatch && scopeMatch && typeMatch && statusMatch;
      card.hidden = !show;
      if (show) visible += 1;
    });

    countLabel.textContent = `Showing ${visible} champion${visible === 1 ? "" : "s"}`;
  }

  cards.forEach((card) => {
    paintCard(card);
    card.querySelector("[data-status-button]")?.addEventListener("click", () => {
      const id = card.dataset.champion;
      const currentIndex = stages.findIndex((stage) => stage.key === stageFor(id).key);
      const next = stages[(currentIndex + 1) % stages.length];
      state[id] = next.key;
      persist();
      paintCard(card);
      updateProgress();
      applyFilters();
    });
  });

  [search, scopeFilter, typeFilter, statusFilter].forEach((control) => {
    control.addEventListener("input", applyFilters);
  });

  document.querySelectorAll("[data-jump]").forEach((button) => {
    button.addEventListener("click", () => {
      scopeFilter.value = "all";
      typeFilter.value = "all";
      statusFilter.value = "all";
      search.value = button.textContent.trim();
      applyFilters();
      document.querySelector(`#champion-${button.dataset.jump}`)?.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  });

  document.querySelector("#export-atlas")?.addEventListener("click", () => {
    const payload = {
      course: "SLOP3745",
      champion: "Volibear",
      dataDragonVersion: "16.17.1",
      exportedAt: new Date().toISOString(),
      statuses: state,
    };
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");
    anchor.href = url;
    anchor.download = "volibear-matchup-atlas.json";
    anchor.click();
    URL.revokeObjectURL(url);
  });

  document.querySelector("#reset-atlas")?.addEventListener("click", () => {
    if (!confirm("Reset every matchup status to Unseen?")) return;
    state = {};
    localStorage.removeItem(storageKey);
    cards.forEach(paintCard);
    updateProgress();
    applyFilters();
  });

  densityButton?.addEventListener("click", () => {
    const compact = atlasGrid?.classList.toggle("compact") ?? false;
    densityButton.setAttribute("aria-pressed", String(compact));
    densityButton.textContent = compact ? "Comfortable view" : "Compact view";
  });

  updateProgress();
  applyFilters();
</script>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .atlas-hero { position: relative; display: grid; min-height: 36rem; align-items: center; margin: 0 0 2.5rem; padding: clamp(2rem, 6vw, 5rem); overflow: hidden; border: 1px solid var(--mastery-line); background: #07101a; isolation: isolate; }
  .atlas-hero-art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 65% center; filter: saturate(0.72) brightness(0.72) contrast(1.15); z-index: -3; }
  .atlas-hero-scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(3 7 14 / 96%) 0 37%, rgb(3 7 14 / 52%) 66%, transparent), linear-gradient(0deg, rgb(3 7 14 / 75%), transparent 55%); z-index: -2; }
  .atlas-hero > div:last-of-type { max-width: 48rem; }
  .atlas-hero h1 { max-width: 10ch; margin: 0; color: #f6f9fb; font-family: "Arial Narrow", "Roboto Condensed", "Public Sans", sans-serif; font-size: clamp(3.5rem, 8vw, 7.5rem); font-weight: 900; line-height: 0.82; letter-spacing: -0.07em; text-transform: uppercase; }
  .atlas-lede { max-width: 62ch; margin-top: 1.5rem; color: #c1cfda; font-size: 1.08rem; }
  .playbook-link { display: inline-flex; margin-top: 0.6rem; padding: 0.8rem 1rem; color: #04101a; background: var(--mastery-accent); font-weight: 900; text-decoration: none; text-transform: uppercase; }
  .atlas-stamp { position: absolute; inset: auto 1.5rem 1.4rem auto; display: grid; margin: 0; text-align: right; }
  .atlas-stamp strong { color: var(--mastery-gold); font-size: clamp(3rem, 7vw, 6rem); line-height: 0.8; }
  .atlas-stamp span { color: white; font: 900 0.65rem ui-monospace, monospace; letter-spacing: 0.15em; }
  .coverage { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin: 2rem 0; border: 1px solid var(--mastery-line); background: var(--mastery-line); }
  .coverage > div { padding: 1.2rem; background: var(--mastery-surface); }
  .coverage p { margin: 0.45rem 0 0; color: var(--mastery-muted); font-size: 0.9rem; }
  .metric { display: flex; align-items: baseline; gap: 0.55rem; }
  .metric strong { color: var(--mastery-accent); font-size: 2rem; line-height: 1; }
  .metric span { color: #eef6fb; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
  .priority { display: grid; grid-template-columns: minmax(14rem, 0.8fr) 1.8fr; gap: 2rem; margin: 3rem 0; padding: clamp(1.25rem, 4vw, 2.5rem); border: 1px solid var(--mastery-line); background: linear-gradient(135deg, rgb(213 173 88 / 12%), var(--mastery-surface) 58%); }
  .priority h2 { margin-top: 0; }
  .priority ol { counter-reset: priority; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.45rem 1.25rem; margin: 0; padding: 0; list-style: none; }
  .priority li { counter-increment: priority; display: flex; align-items: center; gap: 0.5rem; border-bottom: 1px solid var(--mastery-line); }
  .priority li::before { content: counter(priority, decimal-leading-zero); color: var(--mastery-gold); font: 700 0.72rem var(--font-roboto-mono, monospace); }
  .priority button { flex: 1; display: flex; gap: 0.65rem; align-items: center; padding: 0.5rem 0; border: 0; background: transparent; color: inherit; font: inherit; font-weight: 800; text-align: left; cursor: pointer; }
  .priority button img { width: 2.4rem; height: 2.4rem; object-fit: cover; border: 1px solid rgb(255 255 255 / 18%); }
  .dashboard { margin-top: 3.5rem; }
  .dashboard-head { display: flex; gap: 1rem; align-items: end; justify-content: space-between; }
  .dashboard-head h2 { margin: 0; font-size: clamp(2rem, 5vw, 3.5rem); }
  .dashboard-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  button.secondary, button.quiet { padding: 0.7rem 0.9rem; border: 1px solid var(--mastery-accent); background: var(--mastery-accent); color: white; font-weight: 750; cursor: pointer; }
  button.quiet { background: transparent; color: var(--mastery-accent); }
  .atlas-controls { position: sticky; top: 4.8rem; z-index: 30; margin: 1.5rem 0 1rem; padding: 0.75rem; border: 1px solid var(--mastery-line); background: rgb(5 8 17 / 92%); box-shadow: 0 1.2rem 3rem rgb(0 0 0 / 35%); backdrop-filter: blur(18px); }
  .progress-panel { margin: 0 0 0.65rem; padding: 0.85rem; border: 1px solid var(--mastery-line); background: #080e18; }
  .progress-copy { display: flex; justify-content: space-between; gap: 1rem; }
  .progress-copy span { color: var(--mastery-muted); }
  .progress-track { height: 0.55rem; margin-top: 0.8rem; overflow: hidden; background: color-mix(in srgb, var(--mastery-line) 60%, transparent); }
  .progress-track span { display: block; width: 0; height: 100%; background: linear-gradient(90deg, var(--mastery-accent), var(--mastery-gold)); transition: width 220ms ease; }
  .status-legend { display: flex; flex-wrap: wrap; gap: 0.8rem 1rem; margin: 0.75rem 0 0; padding: 0; list-style: none; }
  .status-legend li { display: inline-flex; gap: 0.35rem; align-items: center; color: var(--mastery-muted); font: 800 0.62rem ui-monospace, monospace; letter-spacing: 0.05em; text-transform: uppercase; }
  .status-legend li::before { content: ""; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: #485463; }
  .status-legend [data-stage="planned"]::before { background: #b89a40; }
  .status-legend [data-stage="1v1-tested"]::before { background: #4ba8cf; }
  .status-legend [data-stage="match-tested"]::before { background: #59a978; }
  .status-legend [data-stage="re-tested"]::before { background: #a17ad2; }
  .status-legend [data-stage="mastered"]::before { background: var(--mastery-accent); box-shadow: 0 0 12px rgb(105 217 255 / 55%); }
  .filters { display: grid; grid-template-columns: 1.5fr repeat(3, 1fr); gap: 0.75rem; padding: 1rem; border: 1px solid var(--mastery-line); background: var(--mastery-surface); }
  .filters label { display: grid; gap: 0.35rem; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; }
  .filters :is(input, select) { width: 100%; min-height: 2.75rem; padding: 0.6rem 0.7rem; border: 1px solid var(--mastery-line); border-radius: 0; background: #070d17; color: inherit; font: inherit; text-transform: none; }
  .filter-count { margin: 0.65rem 0 0; color: var(--mastery-muted); font: 700 0.8rem var(--font-roboto-mono, monospace); }
  .atlas-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; }
  .matchup-card { display: flex; flex-direction: column; min-height: 23rem; padding: 0; overflow: hidden; border: 1px solid var(--mastery-line); background: linear-gradient(155deg, #101b2d, #070c15 68%); content-visibility: auto; contain-intrinsic-size: 23rem; transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease; }
  .matchup-card:hover { transform: translateY(-3px); border-color: rgb(105 217 255 / 48%); box-shadow: var(--mastery-glow); }
  .matchup-card.priority { border-top: 4px solid var(--mastery-gold); }
  .matchup-card.mirror { border-color: var(--mastery-accent); background: linear-gradient(155deg, rgb(35 104 136 / 38%), #070c15 68%); }
  .portrait-frame { height: 8rem; overflow: hidden; background: #0b1321; }
  .portrait-frame img { width: 100%; height: 100%; object-fit: cover; image-rendering: auto; transform: scale(1.08); filter: saturate(0.76) contrast(1.1); transition: transform 220ms ease, filter 220ms ease; }
  .matchup-card:hover .portrait-frame img { transform: scale(1.14); filter: saturate(1) contrast(1.06); }
  .card-top { display: grid; grid-template-columns: 1fr auto; gap: 0.7rem; align-items: center; padding: 0.9rem 1rem 0; }
  .card-top h3 { margin: 0; font-size: 1.05rem; }
  .card-top p { margin: 0.15rem 0 0; color: var(--mastery-muted); font-size: 0.75rem; }
  .priority-flag { padding: 0.25rem 0.4rem; background: var(--mastery-gold); color: var(--mastery-ink); font-size: 0.6rem; font-weight: 900; letter-spacing: 0.05em; text-transform: uppercase; }
  .focus { margin: 1rem 1rem 0.6rem; font-size: 0.9rem; }
  .scope-label { margin: 0 1rem; color: var(--mastery-accent); font-size: 0.72rem; font-weight: 800; text-transform: uppercase; }
  details { margin: 0.8rem 1rem; font-size: 0.82rem; }
  details summary { cursor: pointer; font-weight: 750; }
  details ul { padding-left: 1.1rem; }
  .status-button { display: flex; justify-content: space-between; gap: 0.5rem; margin-top: auto; padding: 0.8rem 1rem; border: 0; border-top: 1px solid var(--mastery-line); background: #03060b; color: white; cursor: pointer; }
  .status-button span { opacity: 0.7; }
  [data-status="planned"] .status-button { background: #6d5b24; }
  [data-status="1v1-tested"] .status-button { background: #265c73; }
  [data-status="match-tested"] .status-button { background: #315f46; }
  [data-status="re-tested"] .status-button { background: #593f78; }
  [data-status="mastered"] .status-button { background: var(--mastery-accent); box-shadow: inset 0 -4px 0 var(--mastery-gold); }
  .atlas-grid.compact { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .atlas-grid.compact .matchup-card { min-height: 12rem; contain-intrinsic-size: 12rem; }
  .atlas-grid.compact .portrait-frame { height: 5.2rem; }
  .atlas-grid.compact :is(.focus, .scope-label, details) { display: none; }
  .atlas-grid.compact .card-top { padding-bottom: 0.8rem; }
  .source-note { margin-top: 1.5rem; color: var(--mastery-muted); font-size: 0.78rem; }
  [hidden] { display: none !important; }
  @media (max-width: 64rem) { .filters { grid-template-columns: repeat(2, 1fr); } .atlas-grid, .atlas-grid.compact { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 44rem) {
    .atlas-hero { min-height: 40rem; padding: 1.4rem 1.4rem 6rem; align-items: end; }
    .atlas-hero > div:last-of-type { min-width: 0; width: 100%; }
    .atlas-hero h1 { max-width: 100%; font-size: clamp(2.45rem, 10.7vw, 2.65rem); line-height: 0.84; overflow-wrap: normal; word-break: normal; }
    .atlas-lede { max-width: 100%; }
    .playbook-link { width: 100%; box-sizing: border-box; justify-content: center; text-align: center; }
    .atlas-hero-scrim { background: linear-gradient(0deg, rgb(3 7 14 / 96%) 20%, rgb(3 7 14 / 42%) 72%); }
    .atlas-stamp { inset: auto auto 1.2rem 1.4rem; text-align: left; }
    .coverage, .priority { grid-template-columns: 1fr; }
    .dashboard-head { align-items: start; flex-direction: column; }
    .atlas-controls { position: static; padding: 0.55rem; }
    .status-legend { display: none; }
    .filters, .atlas-grid, .atlas-grid.compact { grid-template-columns: 1fr; }
    .priority ol { grid-template-columns: 1fr; }
  }
</style>
